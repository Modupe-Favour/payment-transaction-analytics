# ============================================================
# Payment Transaction Analytics — environment template
# Copy this file to `.env` and adjust values as needed.
# ============================================================

# --- Database URL (SQLAlchemy format) ---
# Default: SQLite (zero-setup, runs locally + on Streamlit Cloud free tier)
DATABASE_URL=sqlite:///data/payments.db

# --- PostgreSQL (recommended for production / portfolio realism) ---
# Option A: Local Docker (see docker-compose.yml)
# DATABASE_URL=postgresql+psycopg2://analytics:analytics@localhost:5432/payments
#
# Option B: Neon free tier (https://neon.tech) — best for Streamlit Cloud
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxx.region.aws.neon.tech/payments?sslmode=require
#
# Option C: Supabase free tier (https://supabase.com)
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@db.xxx.supabase.co:5432/postgres

# --- Streamlit ---
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501
